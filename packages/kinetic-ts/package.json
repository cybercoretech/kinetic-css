{
  "name": "kinetic-ts",
  "version": "0.2.0",
  "description": "TypeScript add-on for Kinetic CSS — typed APIs and developer tooling.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.ts"
    },
    "./dialog": { "types": "./src/dialog.d.ts", "import": "./src/dialog.ts" },
    "./tabs": { "types": "./src/tabs.d.ts", "import": "./src/tabs.ts" },
    "./dropdown": { "types": "./src/dropdown.d.ts", "import": "./src/dropdown.ts" },
    "./toast": { "types": "./src/toast.d.ts", "import": "./src/toast.ts" },
    "./theme": { "types": "./src/theme.d.ts", "import": "./src/theme.ts" },
    "./form": { "types": "./src/form.d.ts", "import": "./src/form.ts" },
    "./scroll": { "types": "./src/scroll.d.ts", "import": "./src/scroll.ts" }
  },
  "files": [
    "src/*.ts",
    "src/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "kinetic",
    "css",
    "typescript",
    "typed",
    "types",
    "tree-shaking",
    "esm"
  ],
  "peerDependencies": {
    "kinetic-css": ">=0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
