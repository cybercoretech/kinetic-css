{
  "name": "kinetic-js",
  "version": "0.2.0",
  "description": "JavaScript add-on for Kinetic CSS — interactive behavior without external dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dialog": "./src/dialog.js",
    "./tabs": "./src/tabs.js",
    "./dropdown": "./src/dropdown.js",
    "./toast": "./src/toast.js",
    "./theme": "./src/theme.js",
    "./form": "./src/form.js",
    "./scroll": "./src/scroll.js"
  },
  "files": [
    "src/*.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "kinetic",
    "css",
    "javascript",
    "interactive",
    "accessibility",
    "dialog",
    "tabs",
    "dropdown",
    "toast",
    "form-validation"
  ],
  "peerDependencies": {
    "kinetic-css": ">=0.2.0"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
