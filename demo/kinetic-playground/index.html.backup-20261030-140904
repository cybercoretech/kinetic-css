<!doctype html>
<html lang="en" data-k-theme="dark" data-k-density="comfortable">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#100e19">
<title>Kinetic CSS — Playground</title>
<link rel="stylesheet" href="../../css/kinetic.css">
<link rel="stylesheet" href="../../css/kinetic-theme.css">
<style>
:root {
  color-scheme: dark;
  --demo-bg: #100e19;
  --demo-panel: #191625;
  --demo-panel-2: #211d30;
  --demo-line: #383047;
  --demo-muted: #aaa2bb;
  --demo-text: #f7f2ff;
  --demo-accent: #b99aff;
  --demo-cyan: #75e2d0;
  --demo-pink: #ff91c8;
  --demo-radius: 20px;
  --demo-shadow: 0 22px 70px #0005;
  --k-accent: var(--demo-accent);
}
:root[data-k-theme="light"] {
  color-scheme: light;
  --demo-bg: #f5f1fa;
  --demo-panel: #fff;
  --demo-panel-2: #eee8f7;
  --demo-line: #ded5eb;
  --demo-muted: #71677f;
  --demo-text: #21172f;
  --demo-shadow: 0 22px 70px #49365b18;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background:
    radial-gradient(ellipse at 80% 0%, #8055c51c, transparent 35rem),
    var(--demo-bg);
  color: var(--demo-text);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  line-height: 1.6;
}
button, input, select { font: inherit; }
a { color: var(--demo-cyan); }
button { cursor: pointer; }
.container { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
.topbar {
  display:flex; align-items:center; justify-content:space-between;
  gap:20px; padding:20px 0; border-bottom:1px solid var(--demo-line);
}
.brand { display:flex; align-items:center; gap:12px; font-weight:800; letter-spacing:.04em; }
.brand-mark {
  width:36px; height:36px; display:grid; place-items:center;
  border-radius:12px; color:#171020; font-weight:900;
  background:linear-gradient(135deg,var(--demo-accent),var(--demo-cyan));
}
.controls { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
select, .control {
  color:var(--demo-text); background:var(--demo-panel);
  border:1px solid var(--demo-line); border-radius:10px; padding:9px 12px;
}
.hero {
  padding:86px 0 65px; display:grid;
  grid-template-columns:1.2fr .8fr; align-items:center; gap:45px;
}
.eyebrow {
  color:var(--demo-cyan); text-transform:uppercase;
  font-size:.75rem; letter-spacing:.18em; font-weight:800;
}
h1 { font-size:clamp(3rem,7vw,6.2rem); line-height:.98; letter-spacing:-.075em; margin:18px 0; }
.gradient {
  background:linear-gradient(100deg,var(--demo-accent),var(--demo-cyan),var(--demo-pink));
  color:transparent; background-clip:text;
}
.hero p { color:var(--demo-muted); max-width:580px; font-size:1.12rem; }
.actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:25px; }
.demo-button {
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:12px 18px; border:1px solid var(--demo-line);
  border-radius:12px; text-decoration:none; font-weight:700;
  color:var(--demo-text); background:var(--demo-panel);
}
.demo-button.primary {
  color:#171020; border:0;
  background:linear-gradient(110deg,var(--demo-accent),var(--demo-cyan));
}
.orbit {
  min-height:330px; display:grid; place-items:center; position:relative;
  overflow:hidden; border:1px solid var(--demo-line);
  border-radius:32px; background:linear-gradient(145deg,#29203c,#151321);
  box-shadow:var(--demo-shadow);
}
.orbit::before,.orbit::after {
  content:""; position:absolute; width:210px; height:210px;
  border:1px solid #b99aff70; border-radius:50%; transform:rotate(-30deg) scaleX(1.7);
}
.orbit::after { transform:rotate(55deg) scaleX(1.7); border-color:#75e2d070; }
.orbit-core {
  width:100px; height:100px; border-radius:30px; z-index:1;
  display:grid; place-items:center; font-size:2rem; font-weight:900;
  color:#191323; background:linear-gradient(135deg,var(--demo-accent),var(--demo-cyan));
  box-shadow:0 0 80px #b99aff66;
}
.orbit-label { position:absolute; bottom:25px; color:#c7badb; font-size:.8rem; letter-spacing:.15em; }
section { padding:40px 0; }
.section-head { margin-bottom:24px; }
.section-head h2 { font-size:clamp(1.7rem,3vw,2.5rem); letter-spacing:-.05em; margin:5px 0; }
.section-head p { color:var(--demo-muted); margin:0; }
.cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr)); gap:16px; }
.panel {
  background:var(--demo-panel); border:1px solid var(--demo-line);
  border-radius:var(--demo-radius); padding:23px; min-width:0;
}
.panel h3 { margin:0 0 8px; }
.panel p { color:var(--demo-muted); margin:0; }
.icon {
  width:42px; height:42px; display:grid; place-items:center;
  border-radius:13px; margin-bottom:16px; background:var(--demo-panel-2);
  color:var(--demo-cyan); font-size:1.2rem;
}
.lab { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
.preview {
  border:1px dashed var(--demo-line); border-radius:16px;
  padding:20px; background:var(--demo-panel-2);
}
.preview-card {
  container-type:inline-size; padding:18px; border-radius:15px;
  background:var(--demo-panel); border:1px solid var(--demo-line);
}
.preview-card-inner { display:flex; gap:14px; align-items:center; }
.preview-card-inner strong { display:block; }
.preview-card-inner span { color:var(--demo-muted); font-size:.85rem; }
@container (max-width: 340px) {
  .preview-card-inner { align-items:flex-start; flex-direction:column; }
}
.swatch { display:flex; gap:8px; flex-wrap:wrap; margin-top:14px; }
.swatch button {
  border:1px solid var(--demo-line); background:var(--demo-panel-2);
  color:var(--demo-text); border-radius:9px; padding:8px 12px;
}
.swatch button[aria-pressed="true"] { outline:2px solid var(--demo-accent); }
.tabs { display:flex; gap:7px; flex-wrap:wrap; margin-bottom:14px; }
.tab {
  border:1px solid var(--demo-line); color:var(--demo-muted);
  background:var(--demo-panel-2); padding:9px 14px; border-radius:10px;
}
.tab[aria-selected="true"] { color:var(--demo-text); border-color:var(--demo-accent); }
.tab-panel { display:none; }
.tab-panel.active { display:block; }
pre {
  overflow:auto; padding:15px; border-radius:12px;
  background:#100e19; color:#c9f4e9; font-size:.85rem;
}
details { border-bottom:1px solid var(--demo-line); padding:14px 0; }
summary { cursor:pointer; font-weight:700; }
.alert { border:1px solid var(--demo-line); border-radius:12px; padding:13px 15px; margin:9px 0; }
.alert.info { border-left:4px solid #8db9ff; }
.alert.success { border-left:4px solid var(--demo-cyan); }
.alert.warning { border-left:4px solid #f2c36c; }
.progress { height:9px; border-radius:20px; background:var(--demo-panel-2); overflow:hidden; }
.progress > span { display:block; width:72%; height:100%; border-radius:20px; background:linear-gradient(90deg,var(--demo-accent),var(--demo-cyan)); }
.table-wrap { overflow:auto; }
table { width:100%; border-collapse:collapse; text-align:left; }
th,td { padding:12px; border-bottom:1px solid var(--demo-line); white-space:nowrap; }
th { color:var(--demo-muted); font-size:.8rem; }
.pill { display:inline-block; border-radius:30px; padding:3px 9px; font-size:.75rem; background:var(--demo-panel-2); }
footer { padding:40px 0 55px; margin-top:35px; border-top:1px solid var(--demo-line); color:var(--demo-muted); }
dialog {
  max-width:min(480px,calc(100% - 30px)); border:1px solid var(--demo-line);
  border-radius:20px; padding:25px; color:var(--demo-text); background:var(--demo-panel);
}
dialog::backdrop { background:#090711bb; backdrop-filter:blur(5px); }
.toast {
  position:fixed; bottom:22px; right:22px; z-index:5;
  background:var(--demo-panel-2); border:1px solid var(--demo-line);
  padding:14px 18px; border-radius:12px; box-shadow:var(--demo-shadow);
  opacity:0; transform:translateY(10px); pointer-events:none; transition:.2s;
}
.toast.show { opacity:1; transform:translateY(0); }
@media(max-width:760px) {
  .hero { grid-template-columns:1fr; padding-top:55px; }
  .orbit { min-height:260px; }
  .lab { grid-template-columns:1fr; }
  .topbar { align-items:flex-start; flex-direction:column; }
}
</style>
</head>
<body>
<header class="container topbar">
  <div class="brand"><span class="brand-mark">K</span> KINETIC CSS <span class="pill">PLAYGROUND</span></div>
  <div class="controls">
    <label for="theme">Theme</label>
    <select id="theme"><option value="dark">Dark</option><option value="light">Light</option></select>
    <label for="density">Density</label>
    <select id="density"><option value="compact">Compact</option><option value="comfortable" selected>Comfortable</option><option value="spacious">Spacious</option></select>
  </div>
</header>

<main>
<div class="container">
  <section class="hero">
    <div>
      <div class="eyebrow">A responsive CSS toolkit</div>
      <h1>Make room<br>for <span class="gradient">momentum.</span></h1>
      <p>A hands-on tour of Kinetic CSS: adaptive layouts, fluid design, thoughtful components, and a little motion. Change the controls and see the page respond.</p>
      <div class="actions">
        <a class="demo-button primary" href="#features">Explore features ↓</a>
        <a class="demo-button" href="https://github.com/cybercoretech/kinetic-css" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>
    <div class="orbit" aria-label="Abstract kinetic orbital illustration">
      <div class="orbit-core">K</div>
      <div class="orbit-label">LAYOUT · FLOW · ADAPT</div>
    </div>
  </section>

  <section id="features">
    <div class="section-head">
      <div class="eyebrow">01 / The essentials</div>
      <h2>Small toolkit. Big range.</h2>
      <p>Build interfaces that adapt to their content and their environment.</p>
    </div>
    <div class="cards">
      <article class="panel"><div class="icon">↗</div><h3>Fluid by default</h3><p>Responsive sizing and flexible layouts help interfaces move naturally between screen sizes.</p></article>
      <article class="panel"><div class="icon">▦</div><h3>Adaptive components</h3><p>Container-aware components respond to the space they actually have.</p></article>
      <article class="panel"><div class="icon">◉</div><h3>Density controls</h3><p>Explore compact, comfortable, and spacious presentation modes.</p></article>
      <article class="panel"><div class="icon">⌘</div><h3>Native-friendly</h3><p>Use browser primitives like details and dialog without adding a JavaScript framework.</p></article>
    </div>
  </section>

  <section>
    <div class="section-head">
      <div class="eyebrow">02 / Adaptive layout lab</div>
      <h2>Same component. Different space.</h2>
      <p>Resize the preview area to see its card layout switch at the container breakpoint.</p>
    </div>
    <div class="panel lab">
      <div>
        <h3>Try the container</h3>
        <p>Drag the handle on the preview panel's lower-right corner to resize it.</p>
        <div class="swatch">
          <button type="button" data-width="100%">Wide</button>
          <button type="button" data-width="75%">Medium</button>
          <button type="button" data-width="48%">Narrow</button>
        </div>
        <p style="margin-top:20px">This demo uses CSS container queries, so the component reacts to its parent rather than the viewport.</p>
      </div>
      <div class="preview" id="resize-preview" style="resize:horizontal;overflow:auto;min-width:180px;max-width:100%">
        <div class="preview-card">
          <div class="preview-card-inner">
            <div class="icon" style="margin:0">✦</div>
            <div><strong>Adaptive card</strong><span>Resize this container</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <div class="eyebrow">03 / Density studio</div>
      <h2>Find your rhythm.</h2>
      <p>Switch density above or use these presets to compare the same content.</p>
    </div>
    <div class="cards">
      <article class="panel"><span class="pill">COMPACT</span><h3 style="margin-top:12px">Less space</h3><p>For information-dense dashboards and focused workflows.</p></article>
      <article class="panel"><span class="pill">COMFORTABLE</span><h3 style="margin-top:12px">Balanced</h3><p>A versatile baseline for everyday interfaces.</p></article>
      <article class="panel"><span class="pill">SPACIOUS</span><h3 style="margin-top:12px">More room</h3><p>For relaxed reading and touch-friendly layouts.</p></article>
    </div>
  </section>

  <section>
    <div class="section-head">
      <div class="eyebrow">04 / Components</div>
      <h2>Useful building blocks.</h2>
      <p>Interactive examples, with no frontend framework required.</p>
    </div>
    <div class="panel">
      <div class="tabs" role="tablist" aria-label="Component examples">
        <button class="tab" role="tab" aria-selected="true" aria-controls="tab-buttons" id="tab-button-1">Buttons</button>
        <button class="tab" role="tab" aria-selected="false" aria-controls="tab-feedback" id="tab-button-2">Feedback</button>
        <button class="tab" role="tab" aria-selected="false" aria-controls="tab-progress" id="tab-button-3">Progress</button>
      </div>
      <div class="tab-panel active" id="tab-buttons" role="tabpanel" aria-labelledby="tab-button-1">
        <div class="actions">
          <button class="demo-button primary" id="toast-button">Primary action</button>
          <button class="demo-button" id="dialog-button">Open dialog</button>
          <button class="demo-button" type="button" disabled>Disabled</button>
        </div>
        <pre><code>&lt;button class="k-button k-button--primary"&gt;
  Get started
&lt;/button&gt;</code></pre>
      </div>
      <div class="tab-panel" id="tab-feedback" role="tabpanel" aria-labelledby="tab-button-2">
        <div class="alert info">Information: your layout is adapting to its container.</div>
        <div class="alert success">Success: the demo is running locally.</div>
        <div class="alert warning">Heads up: try a narrower viewport.</div>
      </div>
      <div class="tab-panel" id="tab-progress" role="tabpanel" aria-labelledby="tab-button-3">
        <p>Build progress <strong>72%</strong></p>
        <div class="progress" role="progressbar" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100"><span></span></div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <div class="eyebrow">05 / Native HTML</div>
      <h2>Less JavaScript. More platform.</h2>
      <p>Accessible browser features can do a lot of the heavy lifting.</p>
    </div>
    <div class="panel">
      <details open><summary>What makes a layout adaptive?</summary><p style="margin-top:10px">A container query lets a component respond to the size of its containing element, instead of relying only on viewport breakpoints.</p></details>
      <details><summary>Why use native dialog?</summary><p style="margin-top:10px">The dialog element provides built-in modal behavior, focus handling, and Escape-key dismissal in modern browsers.</p></details>
      <details><summary>Can I use this without a framework?</summary><p style="margin-top:10px">Yes. Kinetic CSS is a stylesheet toolkit. This page uses a small amount of plain JavaScript for its interactive controls.</p></details>
    </div>
  </section>

  <section>
    <div class="section-head">
      <div class="eyebrow">06 / Data display</div>
      <h2>A little structure goes a long way.</h2>
    </div>
    <div class="panel table-wrap">
      <table>
        <thead><tr><th>MODULE</th><th>ROLE</th><th>STATUS</th><th>MODE</th></tr></thead>
        <tbody>
          <tr><td>Layout</td><td>Responsive structure</td><td><span class="pill">Ready</span></td><td>Fluid</td></tr>
          <tr><td>Components</td><td>Reusable UI</td><td><span class="pill">Ready</span></td><td>Adaptive</td></tr>
          <tr><td>Tokens</td><td>Visual consistency</td><td><span class="pill">Ready</span></td><td>Configurable</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
</main>

<footer><div class="container">
  <div class="brand"><span class="brand-mark">K</span> KINETIC CSS</div>
  <p>Designed to move with your interface.</p>
  <a href="https://www.npmjs.com/package/kinetic-css" target="_blank" rel="noreferrer">View on npm ↗</a>
  <span> · </span>
  <a href="https://github.com/cybercoretech/kinetic-css" target="_blank" rel="noreferrer">Source on GitHub ↗</a>
</div></footer>

<dialog id="demo-dialog">
  <div class="eyebrow">A native browser feature</div>
  <h2>Hello, Kinetic.</h2>
  <p>This modal uses the HTML dialog element. Press Escape or use the button below to close it.</p>
  <button class="demo-button primary" id="close-dialog">Close dialog</button>
</dialog>
<div class="toast" id="toast" role="status" aria-live="polite">Nice. Your interaction worked.</div>

<script>
(() => {
  const root = document.documentElement;
  const theme = document.querySelector("#theme");
  const density = document.querySelector("#density");
  theme.addEventListener("change", () => {
    root.dataset.kTheme = theme.value;
  });
  density.addEventListener("change", () => {
    root.dataset.kDensity = density.value;
  });

  const preview = document.querySelector("#resize-preview");
  document.querySelectorAll("[data-width]").forEach(button => {
    button.addEventListener("click", () => {
      preview.style.width = button.dataset.width;
    });
  });

  const tabs = [...document.querySelectorAll('[role="tab"]')];
  const panels = [...document.querySelectorAll('[role="tabpanel"]')];
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      tabs.forEach((item, i) => {
        item.setAttribute("aria-selected", String(i === index));
        panels[i].classList.toggle("active", i === index);
      });
    });
    tab.addEventListener("keydown", event => {
      if (!["ArrowRight", "ArrowLeft"].includes(event.key)) return;
      event.preventDefault();
      const next = (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
      tabs[next].focus();
      tabs[next].click();
    });
  });

  const dialog = document.querySelector("#demo-dialog");
  document.querySelector("#dialog-button").addEventListener("click", () => dialog.showModal());
  document.querySelector("#close-dialog").addEventListener("click", () => dialog.close());

  const toast = document.querySelector("#toast");
  let toastTimeout;
  document.querySelector("#toast-button").addEventListener("click", () => {
    toast.classList.add("show");
    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => toast.classList.remove("show"), 2400);
  });
})();
</script>
</body>
</html>
