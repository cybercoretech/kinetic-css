{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@kinetic/core": ["./packages/core/src/index.ts"],
      "@kinetic/js": ["./packages/js/src/index.ts"],
      "@kinetic/ts": ["./packages/ts/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "integrations/**/*.ts"]
}
