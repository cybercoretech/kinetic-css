{
  "plugins": ["stylelint-scss"],
  "rules": {
    "scss/at-rule-no-unknown": true,
    "scss/color-no-invalid": true,
    "color-named": "warn",
    "length-zero-no-unit": true,
    "indentation": 2,
    "block-no-empty": true,
    "number-leading-zero": true,
    "declaration-block-no-duplicate-properties": "warn",
    "block-limit-no-properties": 10,
    "max-empty-lines": 3,
    "scss/at-rule-parent-semicolon": 1,
    "scss/dollar-variable-no-unnecessary-default": true,
    "scss/hex-length": true,
    "scss/hex-notation": "lowercase",
    "scss/leading-zero": true,
    "scss/property-no-vendor-prefix": true,
    "selector-pseudo-class-no-unknown": [true, { "types": ["focus-visible"] }],
    "declaration-block-semicolon-newline-after": "always",
    "font-family-no-missing-glyph": true,
    "scss/at-rule-no-unknown": true,
    "scss/selector-no-reducing-specificity": true,
    "selector-pseudo-element-no-unknown": true
  }
}